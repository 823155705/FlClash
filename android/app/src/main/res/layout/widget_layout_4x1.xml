<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:clipToOutline="true"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp"
    tools:targetApi="s">

    <LinearLayout
        android:id="@+id/widget_open_app"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_glyph"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_glyph_idle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_status_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_status_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_dot"
                    android:tint="@color/widget_text_secondary" />

                <TextView
                    android:id="@+id/widget_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_status_not_running"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_bar_node_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_speed_running"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_down_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_arrow_down"
                        android:textColor="@color/widget_chart_down"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_down_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.025"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_down_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/widget_up_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_arrow_up"
                        android:textColor="@color/widget_chart_up"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_up_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.025"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/widget_up_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_spark_bars"
                    android:layout_width="22dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="1dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_speed_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_tap_to_start"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_mode_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_bg_block"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/widget_mode_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_mode_rule" />

        <TextView
            android:id="@+id/widget_mode_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_mode_rule"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_toggle_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_toggle_bg_idle"
        android:clickable="true"
        android:contentDescription="@string/widget_a11y_toggle"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_toggle_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_play" />

        <ProgressBar
            android:id="@+id/widget_toggle_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/widget_primary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
